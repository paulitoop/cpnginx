# Server environment variables for cpnginx
# Copy this file to .env and update with your values

# PFX_NAME - Name of the PFX file in server/keys/ directory
PFX_NAME="cpnginx-test-server.pfx"

# PFX_PIN - PIN code for the PFX file/container
PFX_PIN=""

# Optional: base64 encoded ZIP or TAR/TAR.GZ archive with PFX inside.
# If /app/keys/$PFX_NAME does not exist, entrypoint restores it from these vars.
# Create ZIP base64 with:
#   ./scripts/convert_pfx.sh server/keys/cpnginx-test-server.pfx
#   CONTAINER_ZIP_BASE64="$(cat server/keys/cpnginx-test-server.pfx.zip.b64)"
CONTAINER_ZIP_BASE64=""
CONTAINER_TAR_BASE64=""

# CSP_LICENSE - CryptoPro CSP license key
# Get license from your CryptoPro administrator
CSP_LICENSE=""
